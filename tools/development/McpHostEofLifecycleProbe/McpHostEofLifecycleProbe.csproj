<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>DocBridge.McpHostEofLifecycleProbe</AssemblyName>
    <RootNamespace>DocBridge.Development.McpHostEofLifecycleProbe</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Guarded production MCP-host stdin-EOF lifecycle probe. Distinct from ExcelOwnerCrashProbe. Never kills Office.</Description>
  </PropertyGroup>
</Project>
